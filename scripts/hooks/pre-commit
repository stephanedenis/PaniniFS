#!/usr/bin/env bash
# =============================================================================
# pre-commit hook — Exige une entrée journal pour chaque commit
# =============================================================================
# Vérifie qu'au moins un fichier Copilotage/journal/YYYY-MM-DD*.md
# (avec la date du jour) est présent dans les fichiers stagés.
#
# Bypass: git commit --no-verify
# Installation: cp scripts/hooks/pre-commit .git/hooks/pre-commit
# =============================================================================

set -euo pipefail

TODAY=$(date +%Y-%m-%d)
JOURNAL_DIR="Copilotage/journal"

# Chercher dans les fichiers stagés un journal du jour
JOURNAL_FOUND=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -c "^${JOURNAL_DIR}/${TODAY}" || true)

if [[ "$JOURNAL_FOUND" -eq 0 ]]; then
    echo ""
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║  ❌  COMMIT REFUSÉ — Entrée journal manquante              ║"
    echo "╠══════════════════════════════════════════════════════════════╣"
    echo "║                                                            ║"
    echo "║  Chaque commit doit inclure une entrée de journal du jour. ║"
    echo "║                                                            ║"
    echo "║  📝 Créez un fichier :                                     ║"
    echo "║     ${JOURNAL_DIR}/${TODAY}-<description>.md                ║"
    echo "║                                                            ║"
    echo "║  Puis ajoutez-le au commit :                               ║"
    echo "║     git add ${JOURNAL_DIR}/${TODAY}-*.md                    ║"
    echo "║                                                            ║"
    echo "║  Sections obligatoires :                                   ║"
    echo "║    - Contexte                                              ║"
    echo "║    - Décisions clés                                        ║"
    echo "║    - Fichiers modifiés                                     ║"
    echo "║    - Tests effectués                                       ║"
    echo "║    - Prochaines étapes                                     ║"
    echo "║                                                            ║"
    echo "║  ⚠️  Bypass (urgences uniquement) :                        ║"
    echo "║     git commit --no-verify                                 ║"
    echo "║                                                            ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo ""
    exit 1
fi

# Vérifier que le journal contient les sections obligatoires
for journal_file in $(git diff --cached --name-only --diff-filter=ACM \
    | grep "^${JOURNAL_DIR}/${TODAY}"); do

    MISSING_SECTIONS=""

    for section in "Contexte" "Décisions" "Fichiers modifiés" "Tests" "Prochaines étapes"; do
        if ! grep -qi "## .*${section}" "$journal_file" 2>/dev/null; then
            MISSING_SECTIONS="${MISSING_SECTIONS}\n    - ${section}"
        fi
    done

    if [[ -n "$MISSING_SECTIONS" ]]; then
        echo ""
        echo "⚠️  Journal ${journal_file} : sections manquantes :"
        echo -e "$MISSING_SECTIONS"
        echo "   (avertissement, pas bloquant)"
        echo ""
    fi
done

exit 0
